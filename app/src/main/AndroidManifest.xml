<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- 网络：JM 接口、以及图片/文件下载 -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- 长下载用前台服务常驻通知（计划 §8「下载」一行） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Android 13+ 通知需要运行时权限；App 在用户首次需要后台任务时按场景申请（§9.1） -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 下载期间避免 CPU 休眠；请求忽略电池优化由用户在系统设置里操作 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!--
      「关于」页自更新：安装下载好的 APK 需要"安装未知应用"授权（API 26+）。
      这不是运行时弹窗权限——manifest 声明它之后，代码里用
      canRequestPackageInstalls() 检查、不够就跳 ACTION_MANAGE_UNKNOWN_APP_SOURCES
      引导用户在系统设置里给本应用开开关。
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <!--
      「打开文件夹」要跳到系统的文件管理器（DocumentsUI 或第三方文件管理器）。
      Android 11+ 有**软件包可见性**过滤：不声明这一段的话，系统会把文件管理器
      判定成"看不见的应用"，startActivity 直接抛 ActivityNotFoundException
      （模拟器实测：`AppsFilter: interaction ... documentsui BLOCKED`，
      表现成"点了没反应，只弹一句没有可以打开文件夹的应用"）。
      这只是"允许查找"，**不需要任何存储权限**——读目录的是文件管理器自己。
    -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="vnd.android.document/directory" />
        </intent>
        <!-- 打开单个成品（zip / pdf）时用的两个 MIME 也一并声明 -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/zip" />
        </intent>
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/pdf" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/zip" />
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND" />
            <data android:mimeType="application/pdf" />
        </intent>
        <!-- 「关于」页安装新版本 APK（系统包安装器） -->
        <intent>
            <action android:name="android.intent.action.VIEW" />
            <data android:mimeType="application/vnd.android-package-archive" />
        </intent>
    </queries>


    <application
        android:name=".JmComicApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.JMComicH.CardWhite"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.JMComicH.CardWhite"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          下载前台服务：长下载的常驻通知与进度（计划 §8）。
          exported=false：只由应用内部拉起，不接受外部 Intent。
          foregroundServiceType=dataSync：manifest 里显式声明，Android 14+ 必需
          （对应 FOREGROUND_SERVICE_DATA_SYNC 权限）。
        -->
        <service
            android:name=".core.download.DownloadForegroundService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
    </application>

</manifest>
