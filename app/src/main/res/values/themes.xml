<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- ============================================================
        默认主题：浅色 + 无 ActionBar
        ============================================================ -->
    <style name="Theme.HaruhiBox" parent="android:Theme.Material.Light.NoActionBar" />


    <!-- ============================================================
         深色主题：深色背景 + 浅色文字 + 无 ActionBar
         —— 夜间模式、暗色模式首选
         ============================================================ -->
    <style name="Theme.HaruhiBox.Dark" parent="android:Theme.Material.NoActionBar" />


    <!-- ============================================================
         浅色 + 深色 ActionBar
         —— 内容区浅色，顶部标题栏深色，对比强烈
         —— 注意：你现在是 NoActionBar，如果想看到 ActionBar 效果，
            需要 App 里用的是系统 ActionBar 而不是自绘 Toolbar
         ============================================================ -->
    <style name="Theme.HaruhiBox.DarkActionBar"
        parent="android:Theme.Material.Light.DarkActionBar" />


    <!-- ============================================================
         浅色 + 全屏（隐藏状态栏）
         —— 会盖住状态栏区域，适合启动页 / 视频播放页
         ============================================================ -->
    <style name="Theme.HaruhiBox.Fullscreen"
        parent="android:Theme.Material.Light.NoActionBar.Fullscreen" />


    <!-- ============================================================
         浅色 + 半透明系统栏
         —— 状态栏、导航栏半透明，内容延伸到系统栏后面
         —— 通常配合 fitsSystemWindows / WindowInsets 使用
         ============================================================ -->
    <style name="Theme.HaruhiBox.Translucent"
        parent="android:Theme.Material.Light.NoActionBar.TranslucentDecor" />


    <!-- ============================================================
         浅色 + 无 ActionBar + 悬浮对话框风格
         —— 把 Activity 做成"对话框"外观，窗口不铺满全屏
         —— 适合分享弹窗、快速设置这类页面
         ============================================================ -->
    <style name="Theme.HaruhiBox.Dialog"
        parent="android:Theme.Material.Light.Dialog.NoActionBar" />




    <!-- ============================================================
         灰底白卡主题
         —— 顶栏 / 底栏 / 卡片：纯白 #FFFFFF
         —— 内容区底色：浅灰 #F5F5F5
         —— 状态栏 / 导航栏：白底 + 深色图标
         ============================================================ -->
    <style name="Theme.HaruhiBox.CardWhite"
        parent="android:Theme.Material.Light.NoActionBar">

        <!-- ① 顶栏 / Toolbar / ActionBar 默认背景 → 白 -->
        <item name="android:colorPrimary">#FFFFFFFF</item>
        <item name="android:colorPrimaryDark">#FFFFFFFF</item>

        <!-- ② 状态栏：白底 + 深色图标（图标深色需要 API 23+） -->
        <item name="android:statusBarColor">#FFFFFFFF</item>
        <item name="android:windowLightStatusBar">true</item>

        <!-- ③ 导航栏：白底 + 深色图标（图标深色需要 API 27+） -->
        <item name="android:navigationBarColor">#FFFFFFFF</item>
<!--        <item name="android:windowLightNavigationBar">true</item>-->

        <!-- ④ 内容区底色 → 浅灰 -->
        <!-- 注意：`windowBackground` 不能跟着用灰色。它是**首帧之前**整窗铺的底色，
             edge-to-edge 下状态栏/导航栏那条露出的就是它；用灰色的话，顶栏与底栏
             边缘会看到一圈灰边（App 起来后两侧仍有 1px 级的过渡）。
             真正的"滚动内容区灰色"由 Compose 侧各页自己铺 `colorScheme.background`。 -->
        <item name="android:colorBackground">#FFF5F5F5</item>
        <item name="android:windowBackground">#FFFFFFFF</item>

        <!-- ⑤ 悬浮层 / 卡片 / 弹窗 / PopupMenu 背景 → 纯白 -->
        <item name="android:colorBackgroundFloating">#FFFFFFFF</item>

        <!-- ⑥ 强调色：按钮、选中、链接、开关等 -->
        <item name="android:colorAccent">#FF3F8CFF</item>

        <!-- ⑦ 文字颜色（白底上必须用深色文字） -->
        <item name="android:textColorPrimary">#DE000000</item>
        <item name="android:textColorSecondary">#8A000000</item>
        <item name="android:textColorTertiary">#61000000</item>
        <item name="android:textColorHint">#61000000</item>
        <item name="android:textColorPrimaryInverse">#FFFFFFFF</item>

        <!-- ⑧ 列表分隔线：浅灰，不要纯黑 -->
        <item name="android:colorControlNormal">#8A000000</item>
        <item name="android:colorControlHighlight">#1F000000</item>

        <!-- ⑨ 弹窗调暗层（对话框后面的遮罩） -->
        <item name="android:backgroundDimAmount">0.4</item>
    </style>
</resources>